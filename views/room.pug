html
    head
        title= "Sigma Watch"
        link(rel="stylesheet", type="text/css", href="/static/index.css")
        link(rel="stylesheet", type="text/css", href="/static/room.css")
        script(src="/static/room.js" async="true")
        meta(name="og:image" content=`/images/${room.room_id}.webp`)
        meta(property="og:image:type" content="image/webp")
        meta(name="viewport", content="width=device-width, initial-scale=1")
    body
        header
        nav
            a(href="/")="Back to Homepage"
        h1(style="text-align: center;")=`Watch Live`
        div(class="video-wrapper")
            div(class="loader hidden")
                progress
            video(controls="true" poster=`/images/${room.room_id}.webp`)
        aside
            span=`Viewers: `
            span(id="viewer-counter")=room.viewer_count
        dialog(id="error-dialog")
            h3 Could not establish connection with the remote server
            p Unknown error occurred and a remote connection could not be established.
            a(href="/")="Back to Homepage"



